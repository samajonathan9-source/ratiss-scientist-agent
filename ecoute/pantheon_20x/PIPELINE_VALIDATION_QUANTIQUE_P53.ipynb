    "# Visualisations physiques comparatives (Gap de Spin vs Entropie)\n",
    "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(15, 5))\n",
    "\n",
    "# Graphique 1 : Gap de Spin Delta_s par mutant\n",
